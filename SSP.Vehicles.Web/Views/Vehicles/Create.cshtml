@model SSP.Vehicles.Web.Models.Vehicle

<form class="vehicle-form" asp-controller="vehicles" asp-action="Create" method="post" >
	<input asp-for="Automaker" placeholder="Marca" />
    <input asp-for="Year" placeholder="Ano" /> 
	<input asp-for="LicensePlate" placeholder="Placa">
    <input asp-for="Price" placeholder="Preço"/>
    <input asp-for="FipeCode" placeholder="023065-0" />
    <input asp-for="FipeFuel" placeholder="Gasolina" />
    <input asp-for="FipeModel" placeholder="Modelo" />
    <input asp-for="Color" placeholder="Cor" />
    <button type="submit">Cadastrar</button>
</form>