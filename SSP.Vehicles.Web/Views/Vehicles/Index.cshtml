@model IEnumerable<SSP.Vehicles.Web.Models.Vehicle>

<h1>Veículos em Estoque</h1>

<table>
    <thead>
    <tr>
		<th>Placa</th>
        <th>Marca</th>
        <th>Código FIPE</th>
        <th>Preço</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var vehicle in Model)
    {
        <tr>  <!-- TODO: LINK EDITAR EM CADA LINHA  -->
			<td>@vehicle.LicensePlate</td>
            <td>@vehicle.Automaker</td>
            <td>@vehicle.FipeCode</td>
            <td>@vehicle.Price</td>
        </tr>
    }
   
    </tbody>
</table>