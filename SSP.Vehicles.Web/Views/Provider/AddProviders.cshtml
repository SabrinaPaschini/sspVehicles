@model SSP.Vehicles.Web.Models.Provider

<form class="provider-form" asp-controller="Provider" asp-action="AddProviders" method="post" >
    <input asp-for="Name" placeholder="Nome"/>
    <input asp-for="Email" placeholder="Email"/> 
    <input asp-for="Phone" placeholder="(11)59885985">
    <input asp-for="Address" placeholder="Endereço"/>
    <input asp-for="City" placeholder="Cidade" />
    <input asp-for="State" placeholder="Estado" />
    <input asp-for="Zip" placeholder="CEP" />
    <input asp-for="Country" placeholder="Cidade" />
    <button type="submit">Cadastrar</button>
</form>