@model IEnumerable<SSP.Vehicles.Web.Models.Provider>

<h1>Fornecedores</h1>

<table>
    <thead>
    <tr>
        <th>Fornecedor:</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var provider in Model)
    {
        <tr>
            <td>@provider.Name</td>
            <td>@provider.Email</td>
            <td>@provider.Address</td>
            <td>
                <a asp-action="EditProvider" asp-route-id="@provider.ProviderId">Editar </a>
            </td>
            <td>
                <a asp-action="DeleteProvider" asp-route-id="@provider.ProviderId">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
